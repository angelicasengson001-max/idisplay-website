  <div id="image-lightbox" class="image-lightbox" hidden="" role="dialog" aria-modal="true" aria-labelledby="image-lightbox-title">
   <div class="image-lightbox-content">
    <h2 id="image-lightbox-title" class="sr-only">Enlarged exhibit image</h2>
    <div id="image-lightbox-preview" class="image-lightbox-preview" role="img" aria-label="Enlarged exhibit image"></div><button id="image-lightbox-close" class="image-lightbox-close" type="button" aria-label="Close enlarged image">×</button>
   </div>
