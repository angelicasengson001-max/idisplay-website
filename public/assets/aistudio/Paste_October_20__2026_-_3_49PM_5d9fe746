  <script>
  const pages=["home","projects","custom-exhibits","promotional-events","permanent-displays","commercial-interiors","point-of-sales","larger-than-life-graphics","about","services","contact"];
  const menuButton=document.getElementById("menu-toggle");
  const mobileMenu=document.getElementById("mobile-menu");
  const projectsGroup=document.querySelector(".projects-nav-group"),projectsLink=document.getElementById("nav-projects"),projectsDropdown=document.getElementById("projects-dropdown");
  function closeProjects(){projectsGroup.classList.remove("is-open");projectsLink.setAttribute("aria-expanded","false")}
  function toggleProjects(){const open=!projectsGroup.classList.contains("is-open");projectsGroup.classList.toggle("is-open",open);projectsLink.setAttribute("aria-expanded",String(open))}
  projectsLink.addEventListener("click",event=>{if(window.matchMedia("(max-width: 820px)").matches){event.preventDefault();toggleProjects()}else{event.preventDefault();closeProjects();location.hash="#projects"}});
  projectsLink.addEventListener("keydown",event=>{if(event.key==="Enter"||event.key===" "){event.preventDefault();toggleProjects()}if(event.key==="ArrowDown"){event.preventDefault();projectsDropdown.querySelector("a")?.focus()}});
  projectsDropdown.addEventListener("click",event=>{
    const customLink=event.target.closest('a[href="#custom-exhibits"]');
    closeProjects();
    if(customLink){event.preventDefault();window.location.hash="custom-exhibits";}
  });
  document.addEventListener("click",event=>{if(!projectsGroup.contains(event.target))closeProjects()});
  document.addEventListener("keydown",event=>{if(event.key==="Escape")closeProjects()});
  projectsGroup.addEventListener("mouseleave",()=>closeProjects());
  const mobileProjectsGroup=document.querySelector(".mobile-projects-group"),mobileProjectsLink=document.getElementById("mobile-projects-link");
  mobileProjectsLink.addEventListener("click",event=>{event.preventDefault();const open=!mobileProjectsGroup.classList.contains("is-open");mobileProjectsGroup.classList.toggle("is-open",open);mobileProjectsLink.setAttribute("aria-expanded",String(open))});
  document.querySelectorAll('.mobile-projects-dropdown a[href="#custom-exhibits"]').forEach(link=>link.addEventListener("click",event=>{event.preventDefault();closeMenu();window.location.hash="custom-exhibits"}));
  function closeMenu(){mobileMenu.classList.remove("open");mobileMenu.inert=true;mobileProjectsGroup?.classList.remove("is-open");mobileProjectsLink?.setAttribute("aria-expanded","false");menuButton.setAttribute("aria-expanded","false");menuButton.setAttribute("aria-label","Open navigation menu")}
  menuButton.addEventListener("click",()=>{const opening=!mobileMenu.classList.contains("open");mobileMenu.classList.toggle("open",opening);mobileMenu.inert=!opening;menuButton.setAttribute("aria-expanded",String(opening));menuButton.setAttribute("aria-label",opening?"Close navigation menu":"Open navigation menu")});
  document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!mobileMenu.inert){closeMenu();menuButton.focus()}});
  function navigateTo(page){if(!pages.includes(page))page="home";if(location.hash.slice(1).toLowerCase()===page)showRoute(true);else location.hash=page}
  function showRoute(focus=false){const requested=location.hash.slice(1).toLowerCase();const page=pages.includes(requested)?requested:"home";pages.forEach(name=>document.getElementById("view-"+name).hidden=name!==page);document.querySelectorAll(".nav-link").forEach(link=>{if(link.getAttribute("href")==="#"+page)link.setAttribute("aria-current","page");else link.removeAttribute("aria-current")});closeProjects();closeMenu();window.scrollTo(0,0);if(focus)document.getElementById(page+"-heading").focus({preventScroll:true})}
  function bindPrimaryNavigation(selector){document.querySelectorAll(selector).forEach(link=>link.addEventListener("click",event=>{const target=link.getAttribute("href");if(!target||!target.startsWith("#"))return;event.preventDefault();navigateTo(target.slice(1).toLowerCase())}))}
  bindPrimaryNavigation('.desktop-nav > a[href^="#"]');
  bindPrimaryNavigation('#mobile-menu > a[href^="#"]');
  bindPrimaryNavigation('a[href="#permanent-displays"]');
  document.querySelectorAll('.image-window').forEach(carousel=>{
    const slides=[...carousel.querySelectorAll('.carousel-slide')];
    if(!slides.length)return;
    const indicator=carousel.querySelector('.carousel-indicator');
    let index=0;
    function showSlide(nextIndex){index=(nextIndex+slides.length)%slides.length;slides.forEach((slide,slideIndex)=>slide.classList.toggle('hidden',slideIndex!==index));if(indicator)indicator.textContent=`${index+1}/${slides.length}`}
    carousel.querySelector('.carousel-prev')?.addEventListener('click',event=>{event.stopPropagation();showSlide(index-1)});
    carousel.querySelector('.carousel-next')?.addEventListener('click',event=>{event.stopPropagation();showSlide(index+1)});
    carousel.addEventListener('click',event=>{
      if(event.target.closest('.carousel-arrow'))return;
      const activeSlide=event.target.closest('.carousel-slide:not(.hidden)');
      if(activeSlide&&carousel.contains(activeSlide))openImageLightbox(activeSlide);
    });
    carousel.addEventListener('keydown',event=>{
      if(event.key!=='Enter'&&event.key!==' ')return;
      if(event.target.closest('.carousel-arrow'))return;
      const activeSlide=event.target.closest('.carousel-slide:not(.hidden)');
      if(activeSlide&&carousel.contains(activeSlide)){event.preventDefault();openImageLightbox(activeSlide)}
    });
    slides.forEach(slide=>{slide.tabIndex=0;slide.setAttribute('role','button')});
  });
  const customExhibitsImage=document.querySelector('[data-template-id="project-1-image"]');
  customExhibitsImage.addEventListener("click",()=>navigateTo("custom-exhibits"));
  customExhibitsImage.addEventListener("keydown",event=>{if(event.key==="Enter"||event.key===" "){event.preventDefault();navigateTo("custom-exhibits")}});
  const promotionalEventsImage=document.querySelector('[data-template-id="project-2-image"]');
  promotionalEventsImage.addEventListener("click",()=>navigateTo("promotional-events"));
  promotionalEventsImage.addEventListener("keydown",event=>{if(event.key==="Enter"||event.key===" "){event.preventDefault();navigateTo("promotional-events")}});
  const imageLightbox=document.getElementById("image-lightbox"),imageLightboxPreview=document.getElementById("image-lightbox-preview"),imageLightboxClose=document.getElementById("image-lightbox-close");
  let lightboxPreviousFocus=null;
  function closeImageLightbox(){imageLightbox.hidden=true;imageLightboxPreview.style.backgroundImage="none";lightboxPreviousFocus?.focus();lightboxPreviousFocus=null}
  function openImageLightbox(image){if(!image?.src)return;lightboxPreviousFocus=document.activeElement;imageLightboxPreview.style.backgroundImage=`url("${image.src}")`;imageLightboxPreview.style.backgroundPosition="center";imageLightboxPreview.style.backgroundRepeat="no-repeat";imageLightboxPreview.style.backgroundSize="contain";imageLightbox.hidden=false;imageLightboxClose.focus()}
  customExhibitsImage.addEventListener("click",()=>openImageLightbox(customExhibitsImage));customExhibitsImage.addEventListener("keydown",event=>{if(event.key==="Enter"||event.key===" "){event.preventDefault();openImageLightbox(customExhibitsImage)}});imageLightboxClose.addEventListener("click",closeImageLightbox);imageLightbox.addEventListener("click",event=>{if(event.target===imageLightbox)closeImageLightbox()});document.addEventListener("keydown",event=>{if(event.key==="Escape"&&!imageLightbox.hidden)closeImageLightbox()});
  window.addEventListener("hashchange",()=>showRoute(true));showRoute();

  const clientsMarquee=document.querySelector(".clients-marquee");
  let dragActive=false,dragStartX=0,dragScrollLeft=0;
  clientsMarquee.addEventListener("pointerdown",event=>{dragActive=true;dragStartX=event.clientX;dragScrollLeft=clientsMarquee.scrollLeft;clientsMarquee.setPointerCapture(event.pointerId)});
  clientsMarquee.addEventListener("pointermove",event=>{if(!dragActive)return;event.preventDefault();clientsMarquee.scrollLeft=dragScrollLeft-(event.clientX-dragStartX)});
  ["pointerup","pointercancel","lostpointercapture"].forEach(type=>clientsMarquee.addEventListener(type,()=>{dragActive=false}));

  const form=document.getElementById("inquiry-form");
  const submitButton=document.getElementById("submit-inquiry");
  const errorBox=document.getElementById("form-error");
  const successBox=document.getElementById("form-success");
  let sheetReady=false;
  async function initializeSheet(){
    if(!window.dataSdk)return false;
    try{const result=await window.dataSdk.init({onDataChanged(){/* Write-only submissions are intentionally not displayed. */}});sheetReady=result.isOk}
    catch(_){sheetReady=false}
    return sheetReady;
  }
  initializeSheet();
  function showMessage(kind,message){const current=kind==="error"?errorBox:successBox;const other=kind==="error"?successBox:errorBox;other.classList.add("hidden");current.textContent=message;current.classList.remove("hidden")}
  form.addEventListener("submit",async event=>{
    event.preventDefault();errorBox.classList.add("hidden");successBox.classList.add("hidden");
    const name=form.elements.name.value.trim(),email=form.elements.email.value.trim(),phone=form.elements.phone.value.trim(),project_type=form.elements.project_type.value,budget_range=form.elements.budget_range.value,message=form.elements.message.value.trim();
    if(!form.checkValidity()||!name||!project_type||message.length<10){showMessage("error","Please complete the required fields and provide at least 10 characters about your project.");form.querySelector(":invalid")?.focus();return}
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){showMessage("error","Please enter a valid email address.");form.elements.email.focus();return}
    submitButton.disabled=true;submitButton.setAttribute("aria-busy","true");
    try{
      if(!sheetReady&&!(await initializeSheet())){showMessage("error","The inquiry form could not connect. Please try again.");return}
      const result=await window.dataSdk.create({name,email,phone,project_type,budget_range,message,created_at:new Date().toISOString()});
      if(!result.isOk){showMessage("error","We could not confirm your inquiry. Please refresh before trying again.");return}
      form.reset();showMessage("success","Thank you. Your inquiry has been received; the iDisplay Inc. team can follow up by email.");
    }catch(_){showMessage("error","We could not confirm your inquiry. Please refresh before trying again.")}
    finally{submitButton.disabled=false;submitButton.removeAttribute("aria-busy")}
  });
</script>
 
